# Senti Quant API key (added in v0.1.0) — REQUIRED.
# As of v2.1.0 the read tool surface needs six read scopes: accounts:read,
# brokers:read, strategies:read, performance:read, trading:read,
# authoring:read. As of v2.5.0 the authoring WRITE tools need a seventh,
# authoring:write — but only if you enable them below. There is no
# key-introspection endpoint, so a missing scope is not caught at startup — it
# surfaces as a 403 naming the scope the first time the affected tool is
# called. See docs/SETUP.md §3.
SENTI_API_KEY=
SENTI_API_BASE_URL=

# Authoring write tools (added in v2.5.0) — optional, OFF by default.
# Set to 1 or true to register the tools that create, replace, delete and
# compile MQL5 drafts. Anything else — including 0, false, no and off — leaves
# them unregistered, and a host that never sets this never sees one in
# tools/list. The key must also hold authoring:write.
# This flag does NOT enable any trading write: closing a position or deploying
# a strategy is a separate surface with a flag of its own that does not exist
# yet. See docs/sprints/epics/EPIC-8.md.
SENTI_ENABLE_AUTHORING_WRITE=

# Smoke-test key (added in v0.1.0) — optional, test-only.
SENTI_SMOKE_KEY=

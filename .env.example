# senti-mcp-server — environment template.
#
# Copy to `.env.local` (gitignored) and fill in the values you need:
#   cp .env.example .env.local
#
# This file is committed and must never contain a real key. `.env.local` is
# ignored by git and is the only place a real key belongs.

# Senti Quant API key (added in v0.1.0) — REQUIRED.
# The first-party key (`sq_live_…`) is itself the bearer token. The server exits
# at startup without it. Create one carrying the `accounts:read` scope at
# https://stage.sentitrade.xyz/account/api-keys
# The key must belong to the same environment SENTI_API_BASE_URL points at — a
# key issued in one environment returns 401 against another.
SENTI_API_KEY=

# Senti API root (added in v0.1.0) — optional.
# Defaults to production, https://api.sentitrade.xyz. Set to
# https://be-dev.sentitrade.xyz to work against development.
# Must be a bare https: origin (http: is accepted for a local API, but sends the
# key in cleartext). A trailing slash is stripped; a query string or fragment is
# rejected at startup.
SENTI_API_BASE_URL=

# Smoke-test key (added in v0.1.0) — optional, test-only.
# Read by `npm run test:smoke`, which makes ONE real authenticated call. When it
# is absent the smoke suite skips rather than fails, so `npm test` and a fresh
# clone stay green without credentials. Usually the same value as SENTI_API_KEY.
SENTI_SMOKE_KEY=

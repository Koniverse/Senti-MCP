# Senti Quant API key (added in v0.1.0) — REQUIRED.
# As of v0.2.0 the tool surface needs five read scopes: accounts:read,
# brokers:read, strategies:read, performance:read, trading:read. There is no
# key-introspection endpoint, so a missing scope is not caught at startup — it
# surfaces as a 403 naming the scope the first time the affected tool is
# called. Only accounts:read is exercised by a shipped tool today
# (list_accounts); see docs/SETUP.md §3.
SENTI_API_KEY=
SENTI_API_BASE_URL=

# Smoke-test key (added in v0.1.0) — optional, test-only.
SENTI_SMOKE_KEY=

# Senti Quant API key (added in v0.1.0) — REQUIRED.
# Read scopes: accounts, brokers, strategies, performance, trading, authoring
# (all :read); authoring:write only for the write tools. A missing scope shows up
# as a 403 on first call, not at startup. See docs/SETUP.md §3.
SENTI_API_KEY=

# Senti API root (added in v0.1.0) — optional, defaults to https://api.sentitrade.xyz.
# Set only for another deployment; http:// sends the key in cleartext.
SENTI_API_BASE_URL=

# Authoring write tools (added in v2.5.0) — optional, OFF by default.
# 1 or true registers the MQL5 draft create/replace/delete/compile tools; needs
# authoring:write. Enables no trading write. See docs/sprints/epics/EPIC-8.md.
SENTI_ENABLE_AUTHORING_WRITE=

# Smoke-test key (added in v0.1.0) — optional, test-only.
SENTI_SMOKE_KEY=

# Live WRITE smoke test (added in v2.8.0) — optional, test-only, OFF by default.
# 1 makes `npm run test:smoke` CREATE AND DELETE A REAL DRAFT — ON PRODUCTION
# unless SENTI_API_BASE_URL says otherwise. Needs authoring:write.
SENTI_SMOKE_WRITES=

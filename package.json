{
  "name": "senti-mcp-server",
  "version": "2.0.0",
  "description": "MCP server exposing the Senti Quant Public API to an AI host",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "bin": {
    "senti-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "agile:status": "koni-docs status --docs-path docs/",
    "agile:validate": "koni-docs validate --docs-path docs/",
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:check": "node scripts/release-check.mjs",
    "release:verify-pack": "node scripts/release-verify-pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/smoke.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "senti",
    "trading"
  ],
  "license": "MIT",
  "author": "bluezdot <thanhtruong27701@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koniverse/Senti-MCP.git"
  },
  "homepage": "https://github.com/Koniverse/Senti-MCP#readme",
  "bugs": {
    "url": "https://github.com/Koniverse/Senti-MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@koniverse/koni-docs": "^0.12.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
